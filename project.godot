; Engine configuration file.
; NIGHTBEAM — owned by the Tech Lead (see .studio/docs/TDD.md). Change via ticket comment.
config_version=5

[application]

config/name="NIGHTBEAM"
config/description="Guide ships past your reef with a single lighthouse beam; the light draws the Shades in."
run/main_scene="res://Scenes/Main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[autoload]

PlaytestBridge="*res://addons/playtest_bridge/playtest_bridge.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[editor_plugins]

enabled=PackedStringArray("res://addons/playtest_bridge/plugin.cfg")

[input]

turn_left={
"deadzone": 0.2,
